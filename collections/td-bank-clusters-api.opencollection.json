{
  "opencollection": "1.0.0",
  "info": {
    "name": "TD Bank Account Basic Accounts Clusters API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.openbanking.amcb.developer.td.com/oauth/v1/authorize",
      "accessTokenUrl": "https://api.openbanking.amcb.developer.td.com/oauth/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Clusters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Purchased FDX Clusters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openbanking.amcb.developer.td.com/fdx/v6/apps/:appId/clusters",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Purchased FDX Clusters"
        },
        {
          "info": {
            "name": "List Entities Supporting Cluster",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openbanking.amcb.developer.td.com/fdx/v6/clusters/:clusterId/entities",
            "params": [
              {
                "name": "clusterId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Entities Supporting Cluster"
        }
      ]
    }
  ],
  "bundled": true
}